# Free-only setup. Fill privately on your existing machine; no new account or paid host needed.
# Never commit populated secrets or put a provider key in Android.
NEWLEAF_DEVICE_TOKEN=
# Use an already available free USDA FoodData Central key. Empty disables USDA/Describe.
USDA_API_KEY=
# Explicit local request ceiling; each Describe item uses at most one search + one detail.
USDA_HOURLY_LIMIT=100
NEWLEAF_QUOTA_FILE=.newleaf-quota.json
NEWLEAF_PORT=8787
# All legacy NUTRITIONIX_* variables are ignored. Commercial routes cannot be enabled.
