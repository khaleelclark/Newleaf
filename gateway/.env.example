# Fill privately on the server; never commit populated secrets or put provider keys in Android.
NEWLEAF_DEVICE_TOKEN=
USDA_API_KEY=
NUTRITIONIX_APP_ID=
NUTRITIONIX_APP_KEY=
# Enable only after account retention, journal/favorites, backups and AI export rights are resolved.
NUTRITIONIX_RIGHTS_CONFIRMED=false
# Explicit request ceilings, not guessed monetary prices. Nutritionix defaults disabled.
USDA_HOURLY_LIMIT=100
NUTRITIONIX_DAILY_LIMIT=0
NEWLEAF_QUOTA_FILE=.newleaf-quota.json
NEWLEAF_PORT=8787
